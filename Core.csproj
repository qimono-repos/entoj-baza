<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    </PropertyGroup>

  <PropertyGroup>
    <PackageId>Qimono.Baza.Entoj</PackageId>
    <Version>1.0.0</Version>                           
    <Title>Baza Entoj (by QiMono)</Title>
    <Authors>QiMono</Authors>
    <Description>Basic Entities for .NET Apps</Description> 
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile> 
    <PackageReadmeFile>README.md</PackageReadmeFile> 
    <PackageProjectUrl>https://qimono76.wordpress.com</PackageProjectUrl> 
    <RepositoryUrl>https://github.com/qimono-repos/entoj-baza.git</RepositoryUrl> 
    <RepositoryType>git</RepositoryType>             
    <PackageTags>domain;models;ddd</PackageTags> 
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild> 
  </PropertyGroup>

  <ItemGroup>
      <None Include="LICENSE.md" Pack="true" PackagePath="" />
      <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
